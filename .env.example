# ==========================================================================
# CALIPER — environment configuration template
#
# Copy to ".env" (repository root) and fill in real values.
# ".env" is already covered by .gitignore (*.env) — never commit real keys.
# ==========================================================================

# --------------------------------------------------------------------------
# LLM provider(s) — Livello 2 (generazione), nodo Flowise
# Cloud o locale, swappable, non architetturalmente privilegiato (vedi
# "Approach" in docs/architettura-prototipo-mesh-llm.md). Riempi solo il
# provider che userai davvero.
# --------------------------------------------------------------------------

# GPT / OpenAI — via cloud (default validato, Fase A invariato)
OPENAI_API_KEY=

# Puntare OPENAI_BASE_URL a un server locale OpenAI-compatible (es. LM
# Studio, già in uso su questa macchina: http://localhost:1234/v1) invece
# della vera API OpenAI cloud. Lasciare vuoto per usare OpenAI di default.
OPENAI_BASE_URL=

# Gemini
GOOGLE_API_KEY=

# Claude API
ANTHROPIC_API_KEY=

# --------------------------------------------------------------------------
# Ollama — modelli locali per Livello 7 (stream-agent: embedding + retrieval)
# Default: IBM Granite, riusati as-is da NORTHSTREAM — leggeri, lasciano
# margine di VRAM per LM Studio/Fusion360 già in esecuzione sulla stessa GPU
# (RTX 5080 16GB, ~1GB in uso a riposo). Granite resta anche alternativa
# valida per il motore di generazione, non solo per l'embedding.
# --------------------------------------------------------------------------
OLLAMA_CHAT_MODEL=granite4:1b
OLLAMA_EMBED_MODEL=granite-embedding:30m
OLLAMA_BASE_URL=http://ollama:11434
# Porta pubblicata sull'host (127.0.0.1), solo per ispezione/debug locale
# — la comunicazione tra container usa sempre OLLAMA_BASE_URL sopra,
# invariato. Cambiala solo se hai già un altro Ollama/servizio sulla
# stessa macchina in ascolto su 11434 (es. un'altra istanza non-CALIPER).
OLLAMA_PORT=11434

# --------------------------------------------------------------------------
# Qdrant — vector store, Livello 7
# --------------------------------------------------------------------------
QDRANT_URL=http://qdrant:6333
# Porte pubblicate sull'host (127.0.0.1) — stessa nota di OLLAMA_PORT
# sopra: solo per ispezione locale, non toccano QDRANT_URL.
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334

# --------------------------------------------------------------------------
# Flowise — motore di esecuzione (L1, L2.5, L2, L7-consultivo)
# --------------------------------------------------------------------------
FLOWISE_PORT=3000
FLOWISE_USERNAME=
FLOWISE_PASSWORD=
# Richiesta da Flowise per cifrare le credenziali salvate nella sua UI
# (le API key inserite lì, non queste). Genera una stringa casuale.
FLOWISE_SECRETKEY_OVERWRITE=

# Per importare automaticamente i chatflow versionati in
# services/flowise/chatflows/ (vedi README, sezione Installazione).
# Non può esistere prima del primo avvio: apri http://localhost:3000,
# registra un account, poi Settings -> API Keys -> crea una chiave e
# incollala qui. Senza questa variabile l'import si salta da solo,
# nessun errore.
FLOWISE_API_KEY=

# --------------------------------------------------------------------------
# Open WebUI — interfaccia di chat, interroga il Livello 7
# (riusata da NORTHSTREAM, non esegue la pipeline)
# --------------------------------------------------------------------------
OPEN_WEBUI_PORT=3010
WEBUI_SECRET_KEY=

# --------------------------------------------------------------------------
# Dashboard — entry point verso lo stack (stato + log in sola lettura di
# ogni servizio, ordinati per livello di pipeline). Nessuna variabile per
# docker-socket-proxy: non pubblica porte verso l'host, raggiungibile solo
# dalla dashboard sulla rete interna caliper-ai.
# --------------------------------------------------------------------------
DASHBOARD_PORT=8000

# --------------------------------------------------------------------------
# PrusaSlicer CLI — Livello 4 (slicing)
# Immagine pre-buildata: billa05/prusacli:latest — nessuna build da
# sorgente necessaria. Vedi tabella componenti nel documento di architettura.
# --------------------------------------------------------------------------
SLICER_PROFILE=./config/prusaslicer/caliper-pla.ini

# --------------------------------------------------------------------------
# Accesso pubblico — Flowise e Open WebUI
# Controlla se queste due UI sono raggiungibili dall'esterno o solo
# dall'host/dagli altri container. La dashboard resta SEMPRE
# raggiungibile dall'esterno qualunque sia questo valore -- e' il
# pannello di controllo/monitoraggio: se si spegnesse da sola servirebbe
# rientrare via SSH per riaccenderla. Docker Compose non ha un vero
# switch ON/OFF sul bind di una porta, solo un indirizzo:
#   0.0.0.0   = ON  (pubblico, raggiungibile dall'esterno)
#   127.0.0.1 = OFF (solo interno — host + altri container via rete
#               Docker, mai spento davvero: dashboard/generate_and_verify.py
#               continuano a parlarci)
# --------------------------------------------------------------------------
PUBLIC_ACCESS=0.0.0.0

# --------------------------------------------------------------------------
# Prompt to Part (services/dashboard/static/prompt-to-part.html)
# RW = interattiva: Normalize/Generate chiamano davvero Ollama/GPT (vedi
#      issue #35 — nessun controllo di accesso su /api/generate, che
#      chiama GPT a pagamento).
# RO = demo statica, Normalize/Generate disabilitati sia in pagina che
#      lato server (i due endpoint rispondono 403 comunque).
# --------------------------------------------------------------------------
PROMPT_TO_PART_MODE=RW

# --------------------------------------------------------------------------
# File condivisi tra i container — struttura unica per L2/L4/L6, utile anche
# per observability/analisi in futuro
# --------------------------------------------------------------------------
DATA_DIR=./data
# ${DATA_DIR}/specs    -> specifiche strutturate L2.5 (JSON)
# ${DATA_DIR}/models   -> codice Python generato + STEP/STL, Livello 2
# ${DATA_DIR}/gcode    -> output PrusaSlicer, Livello 4
# ${DATA_DIR}/dataset  -> dataset congelato, Livello 6
